[tool.pytest.ini_options]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
# Let Home Assistant install its httpx alias before respx is imported
# (pytest-homeassistant's own advice).
addopts = "-p no:respx"
pythonpath = ["."]
testpaths = ["tests"]
# A deprecation warning raised in this integration's code fails the test (2.6).
filterwarnings = ["error::DeprecationWarning:custom_components"]

[tool.ruff]
target-version = "py314"
line-length = 100
extend-exclude = [".venv"]

[tool.ruff.lint]
# E/F/W: errors, I: imports, B: bugbear, UP: modern syntax, SIM: simplify,
# ASYNC: async pitfalls, S: security (bandit)
select = ["E", "F", "W", "I", "B", "UP", "SIM", "ASYNC", "S"]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
# Tests use assert and fake passwords by design.
"tests/*" = ["S101", "S105", "S106"]

[tool.mypy]
python_version = "3.14"
strict = true
warn_unreachable = true
show_error_codes = true
files = ["custom_components/{{ domain }}"]

[tool.coverage.report]
# Type-checking imports never run. Code for only some Home Assistant versions is marked
# "# pragma: no cover" with those versions (2.7); nothing else is excluded.
exclude_also = ["if TYPE_CHECKING:"]
