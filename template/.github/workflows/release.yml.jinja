{% raw %}name: Release

# Started by the maintainer from the Actions tab (Run workflow) on the default branch,
# with the version, for example 0.1.0b1. CI runs every check, then creates the tag and the
# GitHub release. Releases are never made by hand.
on:
  workflow_dispatch:
    inputs:
      version:
        description: Version to release, for example 0.1.0b1
        required: true
        type: string

permissions:
  contents: read

concurrency:
  group: release
  cancel-in-progress: false

jobs:
  version:
    name: Check the version
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0
      - name: Version matches manifest and changelog, and is newer than every release
        env:
          VERSION: ${{ inputs.version }}
        run: |
          echo "$VERSION" | grep -Eq '^0\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(b[1-9][0-9]*)?$' || { echo "$VERSION isn't a version"; exit 1; }
          domain=$(basename custom_components/*/)
          manifest=$(jq -r .version "custom_components/$domain/manifest.json")
          test "$manifest" = "$VERSION" || { echo "manifest.json is $manifest, not $VERSION"; exit 1; }
          grep -q "^## $VERSION (" CHANGELOG.md || { echo "CHANGELOG.md has no $VERSION entry"; exit 1; }
          git tag --list 'v*' | python3 -c '
          import re, sys
          def key(v):
              m = re.fullmatch(r"v?0\.(\d+)\.(\d+)(?:b(\d+))?", v.strip())
              return (int(m[1]), int(m[2]), int(m[3]) if m[3] else float("inf")) if m else None
          new = key(sys.argv[1])
          old = [k for k in map(key, sys.stdin) if k is not None]
          if old and new <= max(old):
              sys.exit(f"{sys.argv[1]} isn'"'"'t newer than every earlier release")
          ' "$VERSION"

  standard:
    name: Standard (release check, including the audit report)
    needs: version
{% endraw %}    uses: jasonaward/ha-integration-standards/.github/workflows/check.yml@{{ _copier_conf.vcs_ref_hash }}{% raw %}
    with:
      release: true

  tests:
    name: Tests
    needs: version
    uses: ./.github/workflows/tests.yml

  validate:
    name: Validate
    needs: version
    uses: ./.github/workflows/validate.yml

  release:
    needs: [standard, tests, validate]
    runs-on: ubuntu-latest
    # Repository settings limit this environment to the default branch (6.2.3).
    environment: release
    permissions:
      contents: write
      id-token: write
      attestations: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Zip the integration
        run: |
          domain=$(basename custom_components/*/)
          cd "custom_components/$domain" && zip -r "../../$domain.zip" . -x '__pycache__/*' '*/__pycache__/*'
      - name: Attest build provenance
        uses: actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8 # v4.2.2
        with:
          subject-path: "*.zip"
      - name: Release notes from the changelog
        env:
          VERSION: ${{ inputs.version }}
        run: |
          awk -v v="$VERSION" '
            index($0, "## " v " (") == 1 { on = 1; next }
            on && /^## / { exit }
            on { print }
          ' CHANGELOG.md > notes.md
          test -s notes.md || { echo "No changelog section for $VERSION"; exit 1; }
      - name: Create the tag and the release
        env:
          GH_TOKEN: ${{ github.token }}
          VERSION: ${{ inputs.version }}
        run: |
          prerelease=""
          case "$VERSION" in *b*) prerelease="--prerelease" ;; esac
          domain=$(basename custom_components/*/)
          gh release create "v$VERSION" "$domain.zip" --repo "$GITHUB_REPOSITORY" \
            --target "$GITHUB_SHA" --title "$VERSION" --notes-file notes.md $prerelease
{% endraw %}
