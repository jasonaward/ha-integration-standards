{% set m = minimum_ha.split('.') %}{% set min_mm = m[0] ~ '.' ~ m[1] %}{% set min_new = (m[0]|int) * 100 + (m[1]|int) >= 202611 %}{% raw %}name: Tests

on:
  push:
  pull_request:
  schedule:
    - cron: "23 6 * * 2" # weekly, including the latest Home Assistant beta
  workflow_dispatch:
  workflow_call: # the release workflow runs these first

permissions:
  contents: read

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: "3.14"
      - run: pip install -r requirements_ci.txt
      - name: Lint (including security rules)
        run: ruff check .
      - name: Formatting
        run: ruff format --check .

  pytest:
    runs-on: ubuntu-latest
    # A failure against the beta is a warning to act on, not a broken build.
    continue-on-error: ${{ matrix.prerelease == 'allow' }}
    strategy:
      fail-fast: false
      matrix:
        include:
          # Home Assistant's own test package, at the latest stable release.
          - name: latest Home Assistant
            packages: pytest-homeassistant -r requirements_test.txt -r requirements_ci.txt
            prerelease: disallow
            coverage: true
            types: true
{% endraw %}          # The minimum version. pytest-homeassistant exists from 2026.11; for an earlier
          # minimum, the retired pytest-homeassistant-custom-component build for it is used,
          # which brings its own pytest-cov, so requirements_ci.txt isn't installed with it.
          - name: minimum supported ({{ min_mm }})
            packages: {% if min_new %}pytest-homeassistant=={{ min_mm }}.* -r requirements_test.txt -r requirements_ci.txt{% else %}homeassistant=={{ min_mm }}.* pytest-homeassistant-custom-component -r requirements_test.txt{% endif %}{% raw %}
            prerelease: disallow
            coverage: true
            types: false
          # The latest beta: an early warning of breaking changes.
          - name: latest beta
            packages: pytest-homeassistant -r requirements_test.txt -r requirements_ci.txt
            prerelease: allow
            coverage: false
            types: false
    name: pytest (${{ matrix.name }})
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: "3.14"
      - env:
          PACKAGES: ${{ matrix.packages }}
          PRERELEASE: ${{ matrix.prerelease }}
        run: |
          pre=""
          if [ "$PRERELEASE" = "allow" ]; then pre="--pre"; fi
          pip install $pre $PACKAGES
      - name: Home Assistant version tested
        run: python -c "from homeassistant.const import __version__ as v; print(f'Tested on Home Assistant {v}')" | tee -a "$GITHUB_STEP_SUMMARY"
      - run: pytest -q --cov=custom_components --cov-branch --cov-report=term-missing --cov-report=json
      - name: Above 95% line coverage in every module
        if: matrix.coverage
        run: python scripts/check_coverage.py coverage.json 95
      - name: Strict type checking (against the latest Home Assistant)
        if: matrix.types
        run: mypy
{% endraw %}
